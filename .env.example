# Base API URL (includes /api suffix or base URL)
# In development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# In production:
# NEXT_PUBLIC_API_URL=https://api.mazaprintwala.com/api

# Public Storefront URL (used for "Open Site" links in admin panel)
# In development:
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
# In production:
# NEXT_PUBLIC_STOREFRONT_URL=https://mazaprintwala.com
